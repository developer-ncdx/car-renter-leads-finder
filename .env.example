# Local service (keep bound to this machine)
SERVER_HOST=127.0.0.1
SERVER_PORT=8787

# Telegram BotFather credentials
TELEGRAM_BOT_TOKEN=replace_with_your_new_rotated_bot_token
TELEGRAM_CHAT_ID=replace_with_your_negative_group_chat_id

# Send every detected post during the Telegram integration test.
# Change to false after the LLM classifier is connected.
BYPASS_LLM=true

# OpenAI credentials (not required while BYPASS_LLM=true)
OPENAI_API_KEY=replace_with_your_openai_api_key
OPENAI_MODEL=gpt-5-nano
