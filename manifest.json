{
  "manifest_version": 3,
  "name": "Live Facebook Lead Observer",
  "version": "0.10.0",
  "description": "Monitors Facebook notifications and group tabs for qualified leads.",
  "permissions": [
    "alarms",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:8787/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Manage monitored Facebook groups",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/groups/*"
      ],
      "js": ["group-config.js", "post-freshness.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.facebook.com/notifications*"
      ],
      "js": ["group-config.js", "notification-content.js"],
      "run_at": "document_idle"
    }
  ]
}
