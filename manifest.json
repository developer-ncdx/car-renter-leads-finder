{
  "manifest_version": 3,
  "name": "Live Car Rental Lead Observer",
  "version": "0.6.0",
  "description": "Detects new Facebook group posts and forwards qualified leads to a local notifier.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8787/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Manage monitored Facebook groups",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/groups/*"
      ],
      "js": ["group-config.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
